rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && ('role' in request.auth.token) && request.auth.token.role == 'admin';
    }
 
    function isVendor() {
      return isAuthenticated() && ('role' in request.auth.token) && request.auth.token.role == 'vendor';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function notModifying(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── MASTER DATA ────────────────────────────────────────────────────────

    // users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if isAdmin()
        || (isOwner(userId) && notModifying(['role', 'uid']));
      allow delete: if isAdmin();
    }

    // venues/{venueId} — public read for active/verified, admin CRUD
    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // vendors/{vendorId}
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() 
        || (isAuthenticated() 
            && request.resource.data.userId == request.auth.uid 
            && request.resource.data.status == 'pending'
            && request.resource.data.verified == false);
      allow update: if isAdmin()
        || (isVendor()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && notModifying(['verified', 'rating', 'status', 'userId', 'payoutStatus']));
      allow delete: if isAdmin();
    }

    // services/{serviceId}
    match /services/{serviceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // packages/{packageId}
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // categories/{categoryId}
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // eventTypes/{eventTypeId}
    match /eventTypes/{eventTypeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // locations/{locationId}
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // venueTypes/{venueTypeId}
    match /venueTypes/{venueTypeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── TRANSACTION DATA ───────────────────────────────────────────────────

    // events/{eventId}
    match /events/{eventId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated()
        && (request.resource.data.customerId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // enquiries/{enquiryId}
    match /enquiries/{enquiryId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // bookings/{bookingId}
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // allocations/{allocationId}
    match /allocations/{allocationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.assignedBy == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // payments/{paymentId}
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false; // Backend Admin SDK only
    }

    // settlements/{settlementId} — controlled settlement ledger
    match /settlements/{settlementId} {
      allow read: if isAdmin()
        || (isVendor() && resource.data.vendorId != null
            && exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create, update, delete: if false; // Backend Admin SDK only
    }

    // quotations/{quotationId} — vendor quotations for customer enquiries
    match /quotations/{quotationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || (isVendor() && resource.data.vendorId != null
            && exists(/databases/$(database)/documents/vendors/$(resource.data.vendorId))
            && get(/databases/$(database)/documents/vendors/$(resource.data.vendorId)).data.userId == request.auth.uid);
      allow create, update, delete: if false; // Backend Admin SDK only via authenticated API
    }

    // reviews/{reviewId}
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── GOVERNANCE & RFQ DATA ──────────────────────────────────────────────

    // rfqs/{rfqId}
    match /rfqs/{rfqId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.customerId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // disputes/{disputeId} — customer or vendor dispute arbitration
    match /disputes/{disputeId} {
      allow read: if isAdmin()
        || (isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.vendorUserId == request.auth.uid));
      allow create: if isAuthenticated()
        && (request.resource.data.customerId == request.auth.uid || request.resource.data.vendorUserId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── SYSTEM DATA ────────────────────────────────────────────────────────

    // notifications/{notificationId} — users see only their own
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && notModifying(['userId', 'type', 'title', 'message', 'createdAt']);
      allow delete: if isAdmin();
    }

    // audit_logs/{logId} — admin read-only, no user manipulation
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    // settings/{settingId} — admin only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ── AGENT WORKFLOWS & CHECKPOINTS ──────────────────────────────────────────
    // Internal orchestrator state stores — read-only for workflow owner / admin, mutations restricted to Admin SDK
    match /agent_workflows/{workflowId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Backend Admin SDK only
    }

    match /agent_checkpoints/{checkpointId} {
      allow read, write: if false; // Backend Admin SDK only
    }

    match /_agent_checkpoints/{checkpointId} {
      allow read, write: if false; // Backend Admin SDK only
    }

    match /agent_checkpoint_writes/{writeId} {
      allow read, write: if false; // Backend Admin SDK only
    }

    // ── WHATSAPP INTEGRATION ────────────────────────────────────────────────────

    // whatsapp_identities/{waId}
    // Backend-only: all mutations happen via Firebase Admin SDK in the backend.
    // Clients (Flutter) cannot read or write identity mapping directly.
    // Admin can inspect for debugging but cannot write (prevents UI-based manipulation).
    match /whatsapp_identities/{waId} {
      allow read: if isAdmin();
      allow write: if false; // Backend Admin SDK only
    }

    // whatsapp_processed_messages/{messageId}
    // Deduplication store — backend-only, no client access.
    match /whatsapp_processed_messages/{messageId} {
      allow read, write: if false; // Backend Admin SDK only
    }

    // ── INSTAGRAM INTEGRATION ───────────────────────────────────────────────────

    // instagram_identities/{igId}
    match /instagram_identities/{igId} {
      allow read: if isAdmin();
      allow write: if false; // Backend Admin SDK only
    }

    // instagram_processed_messages/{messageId}
    match /instagram_processed_messages/{messageId} {
      allow read, write: if false; // Backend Admin SDK only
    }
  }
}
